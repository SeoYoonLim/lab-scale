# backend/.env 예시. 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다(.gitignore).

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:15432/ai_investment

NAVER_CLIENT_ID=<네이버 검색 API client id>
NAVER_CLIENT_SECRET=<네이버 검색 API client secret>
DART_API_KEY=<OpenDART API key>

# JWT 서명 키(HS256). 32자 이상 필수, 없거나 짧으면 서버가 기동하지 않는다.
# 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<32자 이상 임의 문자열로 교체>
