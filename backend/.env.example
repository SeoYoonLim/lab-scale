# backend/.env 예시. 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다(.gitignore).

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:15432/ai_investment

NAVER_CLIENT_ID=<네이버 검색 API client id>
NAVER_CLIENT_SECRET=<네이버 검색 API client secret>
DART_API_KEY=<OpenDART API key>

# JWT 서명 키(HS256). 32자 이상 필수, 없거나 짧으면 서버가 기동하지 않는다.
# 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<32자 이상 임의 문자열로 교체>

# ---------- 운영 설정(비밀값 아님, 생략하면 기본값. 2026-10-28) ----------
# production이면 약한 JWT_SECRET(예시 문구·반복 문자)으로 기동하지 않는다. 기본 development(경고만).
# APP_ENV=development
# 쉼표 구분 허용 origin. 기본 http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 쉼표 구분, 브라우저 JS가 읽을 수 있게 노출할 응답 헤더. 기본 X-Total-Count (GET /api/companies의 전체 건수)
# CORS_EXPOSE_HEADERS=X-Total-Count
# 레이트 리밋(기본 켜짐). 한도: backend/API.md "운영 설정"
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_LOGIN_PER_MIN=10
# LOGIN_LOCK_FAILURES=5
# LOGIN_LOCK_SECONDS=300
# RATE_LIMIT_SIGNUP_PER_HOUR=10
# RATE_LIMIT_ORDERS_PER_MIN=30
# RATE_LIMIT_RESEARCH_PER_MIN=6
# RATE_LIMIT_RESEARCH_CONCURRENT=1
# OLLAMA_HOST=http://127.0.0.1:11434

# ---------- 계정 복구 메일(2026-10-30). SMTP_HOST를 비워 두면 backend/backups/dev_mail.log에 기록한다(개발용) ----------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# FRONTEND_BASE_URL=
# RATE_LIMIT_RECOVERY_PER_MIN=
# RATE_LIMIT_RECOVERY_EMAIL_PER_HOUR=
# RATE_LIMIT_TOKEN_PER_MIN=
# RATE_LIMIT_VERIFICATION_MAIL_PER_HOUR=

# ---------- 소셜 로그인(2026-10-30). 비워 두면 그 공급자 버튼이 꺼진다(GET /api/auth/oauth/providers) ----------
# 네이버 로그인은 뉴스 검색 키(NAVER_CLIENT_ID/SECRET)와 다른 이름을 쓴다.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NAVER_LOGIN_CLIENT_ID=
# NAVER_LOGIN_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=
# RATE_LIMIT_OAUTH_PER_MIN=
# RATE_LIMIT_OAUTH_EXCHANGE_PER_MIN=

# ---------- 보안 통제(2026-10-30, backend/SECURITY.md). 비워 두면 기본값 ----------
# MAX_REQUEST_BODY_BYTES=
# RATE_LIMIT_PUBLIC_GET_PER_MIN=
# RATE_LIMIT_MAIL_PER_RECIPIENT_PER_HOUR=
# RATE_LIMIT_ACCOUNT_DELETE_PER_HOUR=
# HTTPS로만 서비스할 때 1
# SECURITY_HSTS=
